{
  "name": "rex-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Effect-native TypeScript SDK for the Rex server API.",
  "keywords": [
    "effect",
    "pi-package",
    "rex"
  ],
  "license": "MIT",
  "author": "Dillon Mulroy <dillon.mulroy@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate-wire-schemas.ts",
    "check:generated": "node scripts/generate-wire-schemas.ts --check",
    "fetch:rex-api": "node scripts/fetch-rex-api.ts",
    "build": "vp pack",
    "test:live": "REX_SDK_LIVE=1 vp test run src/rex-live.test.ts",
    "test:props": "REX_PROPERTY_SCALE=${REX_PROPERTY_SCALE:-20} vp test run properties exhaustive",
    "ready": "vp run check:generated && vp check && vp test && vp pack",
    "prepare": "vp config || true"
  },
  "dependencies": {
    "effect": "4.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@effect/ai-openai": "4.1.0",
    "@effect/ai-typesafe": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "traits": "^0.5.14",
    "typebox": "1.3.27",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.16.1",
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "rex": {
    "apiRevision": 18,
    "serverVersion": "0.1.0-preview.21",
    "serverCommit": "202b1b3fc0219883112258a8d0f9f95e2d47daa9"
  }
}
